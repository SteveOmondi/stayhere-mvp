    {
      "name": "PRODUCTION — APIM (Bearer token required)",
      "description": {
        "content": "Hits the live R2 bucket through APIM.\nSet the 'token' collection variable to a valid JWT before running.\n\nStep 2 (PUT to R2) does NOT send the Authorization header — the presigned URL is self-signed.",
        "type": "text/plain"
      },
      "item": [
        {
          "name": "Pattern A — Presigned URL",
          "item": [
            {
              "name": "1. Get Presigned URL (image)",
              "request": {
                "method": "POST",
                "header": [
                  {
                    "key": "Content-Type",
                    "value": "application/json"
