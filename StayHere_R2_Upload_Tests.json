                  "host": [
                    "apim-dev-5c27bcf3.azure-api.net"
                  ],
                  "path": [
                    "property",
                    "upload",
                    "presigned-url"
                  ]
                },
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"folder\": \"properties/images\",\n  \"fileName\": \"test-photo.jpg\",\n  \"contentType\": \"image/jpeg\",\n  \"expiryMinutes\": 15\n}",
                  "options": {
                    "raw": {
                      "language": "json"
                    }
                  }
                },
                "description": "Requires Bearer token in the collection auth. Run first."
              },
              "response": [],
