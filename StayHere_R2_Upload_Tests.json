            {
              "name": "2. PUT File to R2 (presigned — direct to R2, no API involved)",
              "request": {
                "method": "PUT",
                "header": [
                  {
                    "key": "Content-Type",
                    "value": "{{r2_contentType}}"
                  }
                ],
                "body": {
                  "mode": "file",
                  "file": {
                    "src": ""
                  }
                },
                "url": {
                  "raw": "{{r2_uploadUrl}}"
                },
                "description": "PUT the file directly to R2 using the presigned URL from Step 1.\n\nIn Postman:\n  Body tab → binary → click 'Select File' and pick any image or PDF.\n\nThe Content-Type header is auto-filled from Step 1 ({{r2_contentType}}).\nDO NOT add an Authorization header — R2 presigned URLs are self-contained.\n\nR2 returns 200 (no body) on success."
              },
              "response": [],
              "event": [
                {
                  "listen": "test",
                  "script": {
                    "type": "text/javascript",
                    "exec": [
                      "pm.test(\"Upload succeeded (200 or 204)\", () => {",
                      "    pm.expect(pm.response.code).to.be.oneOf([200, 204]);",
                      "});",
                      "console.log(\"✅ File uploaded directly to R2. Public URL:\", pm.collectionVariables.get(\"r2_publicUrl\"));"
                    ]
                  }
                }
              ]
            },
            {
              "name": "3. Verify — Get Public URL by File Key",
              "request": {
                "method": "GET",
                "header": [],
                "url": {
                  "raw": "http://localhost:7071/api/upload/url?key={{r2_fileKey}}",
                  "host": [
