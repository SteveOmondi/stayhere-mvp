                    ]
                  }
                }
              ]
            }
          ]
        },
        {
          "name": "Pattern B — Server-Proxied Upload (Multipart)",
          "description": {
            "content": "Single request — POST multipart/form-data to the API. The API forwards bytes to R2.\nSimpler for testing but less efficient for large files.",
            "type": "text/plain"
          },
          "item": [
