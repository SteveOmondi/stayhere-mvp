                      "value": "{{r2_fileKey}}"
                    }
                  ]
                },
                "description": "Resolves the public URL for a file already stored in R2.\nThe {{r2_fileKey}} variable is populated automatically after Step 1 or the multipart upload.",
                "auth": {
