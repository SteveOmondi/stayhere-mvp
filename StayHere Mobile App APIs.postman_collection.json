{
  "info": {
    "_postman_id": "7a793041-ca10-409a-a491-4af9ff5730fb",
    "name": "StayHere — Mobile App APIs",
    "description": "All API endpoints used in the StayHere mobile application.\n\nBase URL: https://apim-dev-5c27bcf3.azure-api.net\n\n🚀 QUICK SETUP:\n1. Run '01 Sign Up' (once) or skip if account exists\n2. Run '02 Login - Request OTP' → check email for 6-digit code\n3. Run '03 Login - Verify OTP' → token + customerId auto-saved to variables\n4. All subsequent requests will use {{token}} and {{customerId}} automatically\n\n📌 VARIABLES (set automatically after login):\n  - {{token}} — JWT Bearer token\n  - {{customerId}} — your customer ID\n  - {{listingId}} — set manually after browsing listings\n  - {{bookingId}} — set automatically after Step 1\n  - {{applicationId}} — set automatically after Step 2\n  - {{conversationId}} — set automatically after first AI Recommend call",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "_exporter_id": "30690740"
  },
  "item": [
    {
      "name": "🔐 1. Authentication",
      "item": [
        {
          "name": "01 Sign Up",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"fullName\": \"Jane Wambui\",\n  \"email\": \"jane@example.com\",\n  \"phoneNumber\": \"+254710000000\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/auth/signup",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "signup"
              ]
            },
            "description": "Create a new Tenant account. phoneNumber is optional.\n\nResponse 200: { \"message\": \"Account created successfully\" }\nError 409: Email already in use"
          },
          "response": []
        },
        {
          "name": "01 Register (Sign-up and Onboard)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"fullName\": \"Jane Wambui\",\n  \"email\": \"jane@example.com\",\n  \"phoneNumber\": \"+254710000000\",\n  \"role\": \"Tenant\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/auth/register",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "register"
              ]
            },
            "description": "Create a new Tenant account. phoneNumber is optional.\n\nResponse 200: { \"message\": \"Account created successfully\" }\nError 409: Email already in use"
          },
          "response": []
        },
        {
          "name": "02 Login - Request OTP",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"Email\": \"renter@example.com\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "login"
              ]
            },
            "description": "⚠️ IMPORTANT: Field name must be Pascal-case: 'Email' or 'PhoneNumber' (not lowercase).\n\nAlternative body (phone login):\n{ \"PhoneNumber\": \"+254700000000\" }\n\nResponse 200: { \"message\": \"OTP sent to your email\" }"
          },
          "response": []
        },
        {
          "name": "03 Login - Verify OTP",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var json = pm.response.json();",
                  "if (json.token) {",
                  "  pm.collectionVariables.set('token', json.token);",
                  "  pm.collectionVariables.set('customerId', json.customerId);",
                  "  console.log('✅ Token and customerId saved to collection variables');",
                  "  console.log('Role:', json.role);",
                  "  if (json.role !== 'Tenant') {",
                  "    console.warn('⚠️ WARNING: Role is ' + json.role + ' — mobile app is Tenant-only!');",
                  "  }",
                  "}"
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"Email\": \"renter@example.com\",\n  \"Otp\": \"901983\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/auth/verifyotp",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "verifyotp"
              ]
            },
            "description": "Submit the 6-digit OTP received by email.\n\n✅ On success: token and customerId are auto-saved to collection variables.\n⚠️ Mobile app must reject any role other than 'Tenant'.\n\nResponse 200:\n{\n  \"token\": \"eyJhbGci...\",\n  \"role\": \"Tenant\",\n  \"userId\": \"usr_abc123\",\n  \"customerId\": \"cust_xyz789\"\n}"
          },
          "response": []
        }
      ]
    },
    {
      "name": "🏠 2. Listings — Browse",
