    {
      "name": "🏘 3. Rental Flow — Step 1: Book Viewing",
      "item": [
        {
          "name": "11 Book a Viewing",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var json = pm.response.json();",
                  "if (json.bookingId) {",
                  "  pm.collectionVariables.set('bookingId', json.bookingId);",
                  "  console.log('✅ bookingId saved:', json.bookingId);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"listingId\": \"{{listingId}}\",\n  \"customerId\": \"{{customerId}}\",\n  \"viewingDate\": \"2026-07-01\",\n  \"viewingTime\": \"10:00\",\n  \"viewingType\": \"InPerson\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/property/bookings",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "property",
                "bookings"
              ]
            },
            "description": "Step 1 of 6 — Schedule a property viewing.\n\nviewingType: 'InPerson' | 'Virtual'\nviewingDate: ISO date string YYYY-MM-DD\nviewingTime: HH:MM (24h)\n\nResponse 201: { bookingId, status: 'Confirmed', viewingDate }\n✅ bookingId is auto-saved to {{bookingId}}"
          },
          "response": []
        }
      ]
    },
    {
      "name": "🏘 4. Rental Flow — Step 2: Apply",
      "item": [
        {
          "name": "12 Submit Application",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var json = pm.response.json();",
                  "if (json.applicationId) {",
                  "  pm.collectionVariables.set('applicationId', json.applicationId);",
                  "  console.log('✅ applicationId saved:', json.applicationId);",
                  "  console.log('Status:', json.status);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"listingId\": \"{{listingId}}\",\n  \"customerId\": \"{{customerId}}\",\n  \"bookingId\": \"{{bookingId}}\",\n  \"employmentType\": \"Employed\",\n  \"monthlyIncome\": 120000,\n  \"employer\": \"Safaricom PLC\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/property/applications",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "property",
                "applications"
              ]
            },
            "description": "Step 2 of 6 — Submit a formal rental application.\n\nemploymentType: 'Employed' | 'SelfEmployed' | 'Unemployed' | 'Student'\nmonthlyIncome: number in KES\n\nResponse 201: { applicationId, status: 'DocumentsPending' }\n✅ applicationId is auto-saved to {{applicationId}}"
          },
          "response": []
        }
      ]
    },
    {
      "name": "🏘 5. Rental Flow — Step 3: Upload Documents",
      "item": [
        {
          "name": "13 Get Presigned Upload URL",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"folder\": \"applications/docs\",\n  \"fileName\": \"national_id.pdf\",\n  \"contentType\": \"application/pdf\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/property/upload/presigned-url",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "property",
                "upload",
                "presigned-url"
              ]
            },
            "description": "Step 3 Phase 1 — Get a time-limited presigned URL for direct upload to Cloudflare R2.\n\nResponse:\n{\n  uploadUrl: \"https://stayhere...r2.cloudflarestorage.com/...?X-Amz-Signature=...\",\n  fileKey: \"applications/docs/national_id.pdf\",\n  publicUrl: \"https://pub-89021444cd6a4a81bacfa5c1dd0427ea.r2.dev/applications/docs/national_id.pdf\",\n  contentType: \"application/pdf\",\n  expiresAt: \"...\"\n}\n\n⚠️ Presigned URLs expire in 15 minutes — do not cache.\n\nAllowed folders:\n- applications/docs\n- applications/signatures\n- properties/images"
          },
          "response": []
        },
        {
          "name": "14 PUT File to R2 (Direct Upload)",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/pdf",
                "description": "⚠️ Must exactly match 'contentType' from presigned URL response — NOT a Bearer header"
              }
            ],
            "body": {
              "mode": "file",
              "file": {
                "src": ""
              }
            },
            "url": {
              "raw": "PASTE_uploadUrl_FROM_STEP_13_RESPONSE_HERE",
              "host": [
                "PASTE_uploadUrl_FROM_STEP_13_RESPONSE_HERE"
              ]
            },
            "description": "Step 3 Phase 2 — Upload the file directly to Cloudflare R2 using the presigned URL.\n\n⚠️ CRITICAL RULES:\n1. Use PUT method (not POST)\n2. Set Content-Type header to EXACTLY the 'contentType' value from step 13 response\n3. Do NOT add Authorization: Bearer header — R2 uses SigV4 embedded in the URL\n4. Body = raw file bytes (not multipart/form-data)\n\nIn mobile app: use HttpPut with the file's byte stream as the body.\nResponse: 200 OK (empty body) = success\nResponse: 403 = Content-Type mismatch — fix the header"
          },
          "response": []
        },
        {
          "name": "15 Submit Document URLs to Application",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"idDocumentUrl\": \"https://pub-89021444cd6a4a81bacfa5c1dd0427ea.r2.dev/applications/docs/national_id.pdf\",\n  \"payslipUrls\": [\n    \"https://pub-89021444cd6a4a81bacfa5c1dd0427ea.r2.dev/applications/docs/payslip_jan.pdf\",\n    \"https://pub-89021444cd6a4a81bacfa5c1dd0427ea.r2.dev/applications/docs/payslip_feb.pdf\",\n    \"https://pub-89021444cd6a4a81bacfa5c1dd0427ea.r2.dev/applications/docs/payslip_mar.pdf\"\n  ],\n  \"bankStatementUrl\": \"https://pub-89021444cd6a4a81bacfa5c1dd0427ea.r2.dev/applications/docs/bank_statement.pdf\",\n  \"signatureUrl\": \"https://pub-89021444cd6a4a81bacfa5c1dd0427ea.r2.dev/applications/signatures/signature.png\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/property/applications/{{applicationId}}/documents",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "property",
                "applications",
                "{{applicationId}}",
                "documents"
              ]
            },
            "description": "Step 3 Phase 3 — After uploading all files to R2, submit their publicUrls to the application record.\n\nSubmit publicUrl values collected from step 13 responses.\nApplication status moves to 'UnderReview' after this call."
          },
          "response": []
        }
      ]
    },
    {
      "name": "🏘 6. Rental Flow — Step 4: Review Terms",
      "item": [
        {
          "name": "16 Get Listing Terms",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/property/listings/{{listingId}}/terms",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "property",
                "listings",
                "{{listingId}}",
                "terms"
              ]
            },
            "description": "Step 4 — Fetch lease terms for display. Only show this screen when applicationStatus === 'Approved'.\n\nResponse:\n{\n  termsId, rentAmount, depositAmount,\n  leaseDurationMonths, moveInDate, termsContent\n}"
          },
          "response": []
        },
        {
          "name": "17 Accept Terms",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/property/applications/{{applicationId}}/accept-terms",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "property",
                "applications",
                "{{applicationId}}",
                "accept-terms"
              ]
            },
            "description": "Step 4 — User confirms acceptance of lease terms. No request body required.\n\nResponse 200: { status: 'TermsAccepted' }\nAdvance to Step 5 (Payment)."
          },
          "response": []
        }
      ]
    },
    {
      "name": "🏘 7. Rental Flow — Step 5: Payment",
      "item": [
        {
          "name": "18 Initiate M-Pesa STK Push",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"phoneNumber\": \"254712345678\",\n  \"amount\": 45000\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/property/applications/{{applicationId}}/payment/initiate",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "property",
                "applications",
                "{{applicationId}}",
                "payment",
                "initiate"
              ]
            },
            "description": "Step 5 — Trigger M-Pesa STK Push to tenant's phone.\n\n⚠️ Phone format: 254XXXXXXXXX (no + prefix, no spaces)\nConvert: 07XXXXXXXX → 2547XXXXXXXX\n\nResponse 200: { checkoutRequestId, message: 'STK Push sent' }\n\nAfter this: poll '19 Check Payment Status' every 4 seconds."
          },
          "response": []
        },
        {
          "name": "19 Check Payment Status (Poll every 4s)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/property/applications/{{applicationId}}/payment/status",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "property",
                "applications",
                "{{applicationId}}",
                "payment",
                "status"
              ]
            },
            "description": "Step 5 — Poll this every 4 seconds after initiating STK Push.\n\nResponse: { status: 'Pending' | 'Completed' | 'Failed', mpesaReceiptNumber }\n\nStop polling when status !== 'Pending'.\nOn 'Completed' → advance to Step 6 (Onboarding)\nOn 'Failed' → show error + offer retry (re-call step 18, no new application needed)"
          },
          "response": []
        }
      ]
    },
    {
      "name": "🏘 8. Rental Flow — Step 6: Onboarding",
      "item": [
        {
          "name": "20 Get Onboarding Details",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/property/applications/{{applicationId}}/onboarding",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "property",
                "applications",
                "{{applicationId}}",
                "onboarding"
              ]
            },
