# Production API base URLs — Azure APIM gateway (used in production builds)
VITE_AUTH_API=https://apim-dev-5c27bcf3.azure-api.net/auth
VITE_PROPERTY_API=https://apim-dev-5c27bcf3.azure-api.net/property
VITE_CUSTOMER_API=https://apim-dev-5c27bcf3.azure-api.net/customers
VITE_STATIC_API=https://apim-dev-5c27bcf3.azure-api.net/staticdata
VITE_AI_API=https://apim-dev-5c27bcf3.azure-api.net/aiagent
VITE_PAYMENTS_API=https://apim-dev-5c27bcf3.azure-api.net/payments

# Google Maps JavaScript API key — powers the map pane on /sage (Sage's full-screen assistant).
# Get one at https://console.cloud.google.com/google/maps-apis (enable "Maps JavaScript API").
# Separate from any server-side Places API key used by the backend. Without this set, /sage still
# works fully — the map pane just shows a "not configured" placeholder instead of a live map.
# VITE_GOOGLE_MAPS_API_KEY=

# Local dev proxy overrides — copy to .env.local (gitignored) and uncomment to route
# specific services to your local Function Apps instead of going through APIM.
# Port must match the Host.LocalHttpPort in each function app's local.settings.json.
# VITE_LOCAL_AUTH=http://localhost:7071
# VITE_LOCAL_PROPERTY=http://localhost:7072
# VITE_LOCAL_OWNER=http://localhost:7074
# VITE_LOCAL_CUSTOMER=http://localhost:7073
# VITE_LOCAL_STATIC=http://localhost:7075
# VITE_LOCAL_AI=http://localhost:7076
# VITE_LOCAL_PAYMENTS=http://localhost:7077
