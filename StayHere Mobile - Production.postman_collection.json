{
  "info": {
    "name": "StayHere Mobile - Production",
    "_postman_id": "64d34577-2d89-4a1a-8abe-aa03b0bfbbfb",
    "description": "API calls a StayHere mobile client makes, in the exact order a user walks through the StayHereClientApp web flow: sign up/log in, browse, favorite/ask Sage/enquire, then book a viewing, a short stay, or apply for a long-term lease, pay via M-Pesa, and manage your profile/bookings afterwards.\n\nNo separate mobile app project exists in this repo yet - this collection is the API contract/spec for building one, kept in sync with StayHereClientApp's actual usage.\n\nSwitch the 'StayHere - Local Dev' / 'StayHere - Production' environment to point every request at the right backend - do not hardcode hosts into requests.\n\nSet the 'token' variable (from step 03) before calling anything past Authentication.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "🔐 1. Authentication",
      "item": [
        {
          "name": "01 Register (Sign-up + Onboard in one step)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/register",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "register"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"Email\": \"jane.doe@example.com\",\n  \"FullName\": \"Jane Doe\",\n  \"Role\": \"Tenant\",\n  \"PhoneNumber\": \"{{customerPhone}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            },
            "description": "Preferred path for a brand-new mobile signup - combines Signup + Onboard into one call. Returns userId/profileId; if it 400s partway through, retry with POST auth/onboard using the returned userId instead of calling this again."
          },
          "response": []
        },
        {
          "name": "02 Login - Request OTP",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "login"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"Email\": \"jane.doe@example.com\",\n  \"PhoneNumber\": null,\n  \"EntraToken\": null\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            },
            "description": "Supply Email OR PhoneNumber (not both) to trigger an OTP. Supplying EntraToken instead performs a full SSO login and skips OTP entirely."
          },
          "response": []
        },
        {
          "name": "03 Login - Verify OTP",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/verifyotp",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "verifyotp"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"Email\": \"jane.doe@example.com\",\n  \"PhoneNumber\": null,\n  \"otp\": \"{{otpCode}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            },
            "description": "Returns {token, user} on success - store token in the 'token' environment variable for every subsequent request."
          },
          "response": []
        },
        {
          "name": "04 Get My Profile",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/auth/profiles/{{userId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "profiles",
                "{{userId}}"
              ]
            }
          },
          "response": []
        }
      ]
    },
