    {
      "name": "🏖️ 8. Short-Stay Booking Flow (nightly stays)",
      "item": [
        {
          "name": "26 Get Listing Availability",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/property/listings/{{listingId}}/availability",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "property",
                "listings",
                "{{listingId}}",
                "availability"
              ]
            },
            "auth": {
              "type": "noauth"
            }
          },
          "response": []
        },
        {
          "name": "27 Create Short-Stay Booking",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/property/short-stay-bookings",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "property",
                "short-stay-bookings"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"listingId\": \"{{listingId}}\",\n  \"customerId\": \"{{customerId}}\",\n  \"checkInDate\": \"2026-11-20\",\n  \"checkOutDate\": \"2026-11-22\",\n  \"guestName\": \"Jane Doe\",\n  \"guestPhone\": \"{{customerPhone}}\",\n  \"guestEmail\": \"{{customerEmail}}\",\n  \"numberOfGuests\": 2,\n  \"specialRequests\": \"Late check-in around 9pm.\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "description": "listingId must be a ShortStay-type listing. The booking fee (half of one night's price) is computed server-side. Returns 409 if the dates overlap an existing booking."
          },
          "response": []
        },
        {
          "name": "28 Initiate M-Pesa STK Push (Booking Fee)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/payments/mpesa/stk/initiate",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "payments",
                "mpesa",
                "stk",
                "initiate"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"shortStayBookingId\": \"{{shortStayBookingId}}\",\n  \"phoneNumber\": \"{{customerPhone}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": []
        },
        {
          "name": "29 Query STK Status (poll every ~4s until Confirmed)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/payments/mpesa/stk/query/{{checkoutRequestId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "payments",
                "mpesa",
                "stk",
                "query",
                "{{checkoutRequestId}}"
              ]
            },
            "description": "Self-healing: if Safaricom's callback never arrives, calling this directly resolves the payment from Safaricom's own record and promotes the booking to Confirmed."
          },
          "response": []
        },
        {
          "name": "30 Get Short-Stay Booking By Id",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/property/short-stay-bookings/{{shortStayBookingId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "property",
                "short-stay-bookings",
                "{{shortStayBookingId}}"
              ]
            }
          },
          "response": []
        },
        {
          "name": "31 Get Presigned Upload URL (ID docs)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/property/upload/presigned-url",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "property",
                "upload",
                "presigned-url"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"Folder\": \"short-stay-bookings/documents\",\n  \"FileName\": \"id-front.jpg\",\n  \"ContentType\": \"image/jpeg\",\n  \"ExpiryMinutes\": 15\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": []
        },
        {
          "name": "32 PUT File to R2 (Direct Upload)",
          "request": {
            "method": "PUT",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/PASTE_uploadUrl_FROM_STEP_31_RESPONSE_HERE",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "PASTE_uploadUrl_FROM_STEP_31_RESPONSE_HERE"
              ]
            },
            "description": "Raw PUT of the file bytes to the uploadUrl returned by step 31, with a matching Content-Type header. Not a StayHere API call."
          },
          "response": []
        },
        {
          "name": "33 Submit ID Verification Document",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/property/short-stay-bookings/{{shortStayBookingId}}/documents",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "property",
                "short-stay-bookings",
                "{{shortStayBookingId}}",
                "documents"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"documentType\": \"IdFront\",\n  \"fileUrl\": \"https://pub-stayhere.r2.dev/short-stay-bookings/documents/id-front.jpg\",\n  \"fileName\": \"id-front.jpg\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "description": "documentType must be IdFront | IdBack | Selfie. Only allowed once the booking is Confirmed (paid)."
          },
          "response": []
        },
        {
          "name": "34 Get My Short-Stay Bookings",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/property/short-stay-bookings/customer/{{customerId}}",
              "host": [
